{
  "name": "harness-dashboard",
  "version": "1.18.4",
  "description": "Local token usage dashboard for AI coding tools (Claude Code, Codex, OpenCode, pi, omp, Cursor)",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "repository": "https://github.com/MSpiechowicz/harness-useful-dashboard",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:server": "bun --watch src/cli.ts serve --no-open --port 4318",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "build": "bun run scripts/build.ts",
    "build:all": "bun run scripts/build.ts --all",
    "start": "bun src/cli.ts",
    "test": "bun test",
    "check": "tsc --noEmit -p tsconfig.json && svelte-check --tsconfig web/tsconfig.json"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.52.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "echarts": "^6.1.0",
    "semantic-release": "^25.0.9",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.0",
    "vite": "^8.3.2"
  }
}
