{
  "$schema": "https://json.schemastore.org/semantic-release.json",
  "branches": [
    "main"
  ],
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/npm",
      {
        "npmPublish": false
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "bun run build:all"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "package.json",
          "CHANGELOG.md"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "dist/harness-dashboard-darwin-arm64",
            "label": "macOS (Apple Silicon)"
          },
          {
            "path": "dist/harness-dashboard-darwin-x64",
            "label": "macOS (Intel)"
          },
          {
            "path": "dist/harness-dashboard-linux-x64",
            "label": "Linux x64"
          },
          {
            "path": "dist/harness-dashboard-linux-arm64",
            "label": "Linux arm64"
          },
          {
            "path": "dist/harness-dashboard-windows-x64.exe",
            "label": "Windows x64"
          },
          {
            "path": "dist/checksums.txt",
            "label": "SHA-256 checksums"
          }
        ],
        "successComment": false,
        "failComment": false,
        "releasedLabels": false
      }
    ]
  ]
}
